  "description": "## Contact\nLocal-only message preview with responsive Bellini layouts and the shared Portfolio navigation. Required name (1–100), email (up to 254), and message (12–4000 characters) are checked by core fields and the preview handler, including trimmed whitespace checks. Button activation, Enter in single-line fields, and form submission share one guarded handler; textarea Enter retains newlines. Feedback is a persistent polite live region and edits invalidate the previous preview. No data is sent or persisted. **Production delivery is blocked until the user provides a backend/email service and end-to-end delivery is verified.** Existing /contact route and contact state are preserved; all Contact navigation uses confirmed sibling states.",
  "name": "contact",
  "params": {},
  "type": "page",
  "url": "/contact",
  "variables": [
    {
      "description": "Local draft only; no backend, recipient, storage, or email service is connected.",
      "name": "contactForm",
      "properties": [
        {
          "description": "",
          "name": "name",
          "type": "property",
          "value": "''"
        },
        {
          "description": "",
          "name": "email",
          "type": "property",
          "value": "''"
        },
        {
          "description": "",
          "name": "message",
          "type": "property",
          "value": "''"
        }
      ],
      "type": "object"
    },
    {
      "description": "idle, error, or ready; ready means locally validated, never sent.",
      "name": "feedbackStatus",
      "type": "property",
      "value": "'idle'"
    },
    {
      "description": "Form-level live feedback; field errors remain inside core inputs.",
      "name": "feedbackMessage",
      "type": "property",
      "value": "''"
    },
    {
      "description": "Trimmed local preview, cleared whenever the draft changes.",
      "name": "preview",
      "type": "property",
      "value": "null"
    },
    {
      "description": "Requests core field validation after an explicit preview attempt.",
      "name": "attempted",
      "type": "property",
      "value": "false"
    },
    {
      "description": "Draft snapshot used to invalidate stale feedback without altering draft values.",
      "name": "lastAttempt",
      "type": "property",
      "value": "''"
    },
    {
      "description": "Whitespace-free email format shared by the core input and local handler.",
      "name": "emailPattern",
      "type": "property",
      "value": "'^[^\\\\s@]+@[^\\\\s@]+[.][^\\\\s@]+$'"
    },
    {
      "body": "const raw = typeof newValue === 'string' ? newValue : '';\nif (raw.length >= minimum && raw.trim().length < minimum) {\n  return minimum === 1 ? 'Enter a name, not only whitespace.' : 'Use at least 12 characters after removing leading and trailing whitespace.';\n}",
      "description": "Adds only the trim-aware business rule when raw required/minLength checks would otherwise pass; avoids duplicate built-in errors.",
